# Copy this file to .env on your VPS. Never commit .env or share real passwords.
# Use only a public hostname here: no https:// prefix, port, slash or path.
DOMAIN=video.example.com
DOWNVIDEO_ACCESS_USER=owner

# Required: create a unique random password of at least 20 characters.
# Leave this blank until you supply your own secret; Compose fails closed.
DOWNVIDEO_ACCESS_PASSWORD=

